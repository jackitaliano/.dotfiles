#!/usr/bin/env bash

insert="~/notes"

dirs=$(echo $TMUX_PATH | tr ':' '\n' | xargs -I {} sh -c 'find "{}" -maxdepth 1 -mindepth 1 \( -name ".*" -o -name "node_modules" \) -prune -o -type d -print')
pretty=$(echo "$dirs\n$insert" | sed "s|^/Users/$USER/|~/|")
 
# selected_pretty=$(printf "$(find ~/projects ~/.dotfiles -mindepth 1 -maxdepth 1 \( -name '.*' -o -name 'node_modules' \) -prune -o -type d -print )\n$HOME/.dotfiles" | sed "s|^/Users/$USER/|~/|" | \
selected_pretty=$(printf "$pretty" | \
	fzf  \
	--preview 'ls -AFh --color $(echo {} | sed "s|^~/|/Users/$USER/|") | bat --color=always --theme=OneHalfDark' \
	--height=100% --padding=2 --border=double --prompt='➤ ' --pointer='→' --preview-label='⟨ Directory Contents ⟩' --header='Tmux Sessionizer' --header-first --color='fg:magenta'
	--bind 'esc:execute-silent(tmux detach > /dev/null 2>&1),ctrl-c:clear-query' 2> /dev/null
)

if [[ -z $selected_pretty ]]; then
	exit 0
fi

selected=$(echo $selected_pretty | sed "s|^~/|/Users/$USER/|")
selected_name=$(basename "$selected" | tr . _)

tmux_running=$(pgrep tmux)

if [[ -z $TMUX ]]; then
	if [[ -z $tmux_running ]]; then
		tmux new-session -s $selected_name -c $selected

	elif tmux has-session -t=$selected_name 2> /dev/null; then
		tmux attach -t $selected_name
	
	elif ! tmux has-session -t=$selected_name 2> /dev/null; then
		tmux new -s $selected_name -c $selected
	fi

	exit 0
fi


if ! tmux has-session -t=$selected_name 2> /dev/null; then
	tmux new-session -ds $selected_name -c $selected
fi


if [[ $1 == "-S" ]]; then
	tmux list-clients \
		| grep -Ev "link|SESSIONIZER" \
		| awk '{print $1}' \
		| sed 's/.$//' \
		| xargs -I {} tmux switch-client -c {} -t $selected_name;
			# tmux detach; tmux send-keys -t SESSIONIZER "ts -S" C-m
else
	tmux switch-client -t $selected_name

	# tmux has-session -t "SESSIONIZER" 2> /dev/null || tmux new-session -ds "SESSIONIZER" && tmux send-keys -t "SESSIONIZER" "ts -S" C-m
fi

