:: default

########################################
# Launch Applications
########################################

:: launch @

alt - space ; launch
launch < escape ; default

launch < return : open_window "Alacritty"; skhd -k "escape"
launch < space : open_window "Microsoft Edge"; skhd -k "escape"
launch < o : open_window "Microsoft Outlook"; skhd -k "escape"
launch < t : open_window "Discord"; skhd -k "escape"
launch < n : open_window "Microsoft OneNote"; skhd -k "escape"
launch < s : open_window "Spotify"; skhd -k "escape"
launch < d : open -a "Docker Desktop"; skhd -k "escape"
launch < shift - n : open -a "Alacritty"; tmux switch-client -t notes || tmux attach -t notes || tmux new -d -s notes -c "$HOME/notes" && tmux switch-client -t notes

########################################
# Focus
########################################

:: focus @

alt - f ; focus
focus < escape ; default

# change focus within space
focus < h : yabai -m window --focus west; skhd -k "escape"
focus < j : yabai -m window --focus south; skhd -k "escape"
focus < k : yabai -m window --focus north; skhd -k "escape"
focus < l : yabai -m window --focus east; skhd -k "escape"

# change focus between external displays (left and right)
focus < shift - h : yabai -m display --focus west; skhd -k "escape"
focus < shift - j : yabai -m display --focus south; skhd -k "escape"
focus < shift - k : yabai -m display --focus north; skhd -k "escape"
focus < shift - l : yabai -m display --focus east; skhd -k "escape"

# change focus between spaces
focus < n : yabai -m space --focus next; skhd -k "escape"
focus < p : yabai -m space --focus prev; skhd -k "escape"

########################################
# Move
########################################

:: move @

alt - m ; move
move < escape ; default

# swap windows
move < j : yabai -m window --swap south; skhd -k "escape"
move < k : yabai -m window --swap north; skhd -k "escape"
move < h : yabai -m window --swap west; skhd -k "escape"
move < l : yabai -m window --swap east; skhd -k "escape"

# move windows across displays
move < shift - h : yabai -m window --display west; yabai -m display --focus west; skhd -k "escape"
move < shift - j : yabai -m window --display south; yabai -m display --focus south; skhd -k "escape"
move < shift - k : yabai -m window --display north; yabai -m display --focus north; skhd -k "escape"
move < shift - l : yabai -m window --display east; yabai -m display --focus east; skhd -k "escape"

# move window to prev and next space
move < p : yabai -m window --space prev; skhd -k "escape"
move < n : yabai -m window --space next; skhd -k "escape"

move < m : yabai -m window --toggle zoom-fullscreen; skhd -k "escape"
move < e : yabai -m space --balance; skhd -k "escape"
move < o : yabai -m space --rotate 90; skhd -k "escape"

# toggles
move < f : yabai -m window --toggle float; skhd -k "escape"


########################################
# Layout
########################################

:: layout @

alt - l ; layout
layout < escape ; default

layout < f : yabai -m config layout float; skhd -k "escape"
layout < b : yabai -m config layout bsp; skhd -k "escape"

########################################
# Run
########################################

:: run @

alt - r ; run
run < escape ; default

run < s : open "https://google.com/search?query=$(pbpaste)"; skhd -k "escape"

########################################
# Links
########################################

:: links @

########################################
# Config
########################################

:: config @

alt - c ; config
config < escape ; default

config < r : skhd -k "escape"; skhd --reload

:: configyabai @

config < y ; configyabai
configyabai < escape ; default

configyabai < q : yabai --stop-service; skhd -k "escape"
configyabai < s : yabai --start-service; skhd -k "escape"
configyabai < r : yabai --restart-service; skhd -k "escape"

:: configdisabled

config < d ; configdisabled
configdisabled < ctrl + alt + cmd - d ; default


