# change window focus within space
cmd + alt - j : yabai -m window --focus south
cmd + alt - k : yabai -m window --focus north
cmd + alt - h : yabai -m window --focus west
cmd + alt - l : yabai -m window --focus east

# change focus between external displays (left and right)
cmd + alt - s : yabai -m display --focus west
cmd + alt - g : yabai -m display --focus east

# swap windows
cmd + ctrl - j : yabai -m window --swap south
cmd + ctrl - k : yabai -m window --swap north
cmd + ctrl - h : yabai -m window --swap west
cmd + ctrl - l : yabai -m window --swap east

# maximize window
cmd + ctrl - return : yabai -m window --toggle zoom-fullscreen

# balance out tree of windows
cmd + ctrl - e : yabai -m space --balance

# move window to prev and next space
cmd + ctrl - p : yabai -m window --space prev;
cmd + ctrl - n : yabai -m window --space next;

# move window to display left and right
cmd + ctrl - s : yabai -m window --display west; yabai -m display --focus west;
cmd + ctrl - g : yabai -m window --display east; yabai -m display --focus east;

# move window to space #
cmd + ctrl - 1 : yabai -m window --space 1;
cmd + ctrl - 1 : yabai -m window --space 2;
cmd + ctrl - 1 : yabai -m window --space 3;
cmd + ctrl - 1 : yabai -m window --space 4;
cmd + ctrl - 1 : yabai -m window --space 5;
cmd + ctrl - 1 : yabai -m window --space 6;
cmd + ctrl - 1 : yabai -m window --space 7;

# Open Applications
alt - return : open -a "Alacritty"
alt - space : open -a "Microsoft Edge"
alt - o : open -a "Microsoft Outlook"
alt - t : open -a "Microsoft Teams"
alt - n : open -a "Microsoft OneNote"
alt - s : open -a "Spotify"
